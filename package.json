{
  "name": "buybot-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"pnpm dev:server\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "test:smoke": "tsx server/dev/smoke.ts",
    "mock:evolution": "tsx server/dev/mock-evolution.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "start": "tsx --env-file-if-exists=.env server/src/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}

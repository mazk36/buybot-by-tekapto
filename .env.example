# Copia este archivo a .env y ajusta los valores.
PORT=8787
DATA_DIR=./data
TZ=America/Lima

# Evolution API (en desarrollo puedes usar: pnpm mock:evolution → http://localhost:8080, clave dev-key)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=dev-key
EVOLUTION_INSTANCE=buybot
# URL con la que Evolution alcanza a BuyBot (webhooks de estado y respuestas).
# En Docker usa http://buybot:8787; en desarrollo local, http://host.docker.internal:8787
# PUBLIC_WEBHOOK_URL=http://buybot:8787

# Cuenta inicial opcional (si no, la pantalla de login pide crearla la primera vez)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Código de un solo uso para reclamar la cuenta de pruebas ya creada.
# ACCOUNT_CLAIM_TOKEN=
# Código de invitación de un solo uso para crear una cuenta adicional compartida.
# ACCOUNT_INVITE_TOKEN=

# true si publicas detrás de HTTPS
COOKIE_SECURE=false

# Solo para docker-compose
BUYBOT_PORT=8787
POSTGRES_PASSWORD=cambia-esto
